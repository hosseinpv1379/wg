FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv/wireguard-service

RUN apt-get update \
    && apt-get install -y --no-install-recommends wireguard-tools \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY app ./app
RUN pip install --no-cache-dir .

COPY deploy/node/agent-entrypoint.sh /usr/local/bin/wg-node-agent-entrypoint
RUN chmod 0755 /usr/local/bin/wg-node-agent-entrypoint

EXPOSE 8787
ENTRYPOINT ["/usr/local/bin/wg-node-agent-entrypoint"]
