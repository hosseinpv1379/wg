WG_DATABASE_URL=sqlite:///./wireguard.db
WG_BOOTSTRAP_API_KEY=replace-with-a-long-random-secret-before-running
WG_BOOTSTRAP_TENANT_ID=local
WG_CONFIG_ENCRYPTION_KEY=generate-a-fernet-key-before-running
WG_AGENT_TOKEN=
