# Set the A record for WG_AGENT_DOMAIN to this node's public IPv4 before startup.
WG_AGENT_DOMAIN=agent-de.example.com
WG_SERVER_HOST=203.0.113.10
WG_SERVER_PORT=51820
WG_SERVER_ADDRESS=10.45.0.1/24
WG_CLIENT_POOL=10.44.0.0/24

# Replace both values with unique random secrets. Never reuse central-panel keys.
WG_AGENT_TOKEN=replace-with-a-unique-random-token
WG_AGENT_STATE_KEY=replace-with-a-unique-fernet-key
