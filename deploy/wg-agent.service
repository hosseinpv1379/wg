[Unit]
Description=WireGuard Service Server Agent
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
Requires=wg-quick@wg0.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/wireguard-service
EnvironmentFile=/etc/wg-agent.env
ExecStart=/opt/wireguard-service/.venv/bin/uvicorn app.agent:app --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wg-agent
PrivateTmp=true

[Install]
WantedBy=multi-user.target
